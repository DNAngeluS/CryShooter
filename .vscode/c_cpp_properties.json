{
    "configurations": [
        {
            "name": "Linux (GCC-9)",
            "includePath": [
                "${workspaceFolder}/Code",
                "${env:CRYENGINE_DIR}/Code/CryEngine/CryCommon",
                "${env:CRYENGINE_DIR}/Code/CryEngine/CryAction",
                "${env:CRYENGINE_DIR}/Code/CryEngine/CrySchematyc/Core/Interface",
                "${env:CRYENGINE_DIR}/Code/CryPlugins/CryDefaultEntities/Module"
            ],
            "defines": [
                "LINUX",
                "__linux__",
                "_DEBUG",
                "DEBUG"
            ],
            "compilerPath": "/usr/bin/g++-9",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "linux-gcc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}