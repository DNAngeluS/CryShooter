{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-S", "${workspaceFolder}/Code",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCRYENGINE_DIR=${config:cryengineDir}",
                "-DCMAKE_TOOLCHAIN_FILE=${config:cryengineDir}/Tools/CMake/toolchain/linux/Linux_GCC.cmake",
                "-DCMAKE_C_COMPILER=gcc-9",
                "-DCMAKE_CXX_COMPILER=g++-9"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Configure (Profile)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "${workspaceFolder}/build",
                "-G", "Ninja",
                "-S", "${workspaceFolder}/Code",
                "-DCMAKE_BUILD_TYPE=Profile",
                "-DCRYENGINE_DIR=${config:cryengineDir}",
                "-DCMAKE_TOOLCHAIN_FILE=${config:cryengineDir}/Tools/CMake/toolchain/linux/Linux_GCC.cmake",
                "-DCMAKE_C_COMPILER=gcc-9",
                "-DCMAKE_CXX_COMPILER=g++-9"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["absolute"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "CMake Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "clean"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
