# Copy this file to .env and fill in your local paths.
# .env is gitignored — never commit it.
#
# Usage (CLI):
#   source .env
#   cmake -B build -G Ninja -S Code -DCMAKE_BUILD_TYPE=Debug \
#     -DCMAKE_TOOLCHAIN_FILE=$CRYENGINE_DIR/Tools/CMake/toolchain/linux/Linux_GCC.cmake \
#     -DCMAKE_C_COMPILER=gcc-9 -DCMAKE_CXX_COMPILER=g++-9
#
# VS Code users: set "cryengineDir" in .vscode/settings.json instead.
# See CLAUDE.md > Prerequisites for full setup instructions.

CRYENGINE_DIR=/path/to/CRYENGINE
