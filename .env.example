# Copy this file to .env and fill in your local paths.
# .env is gitignored — never commit it.
#
# Usage (CLI):
#   source .env
#
#   GCC 9 (default):
#   cmake -B build/gcc -G Ninja -S Code -DCMAKE_BUILD_TYPE=Debug \
#     -DCRYENGINE_DIR=$CRYENGINE_DIR \
#     -DCMAKE_TOOLCHAIN_FILE=$CRYENGINE_DIR/Tools/CMake/toolchain/linux/Linux_GCC.cmake \
#     -DCMAKE_C_COMPILER=gcc-9 -DCMAKE_CXX_COMPILER=g++-9
#
#   GCC 14 (latest stable):
#   cmake -B build/gcc14 -G Ninja -S Code -DCMAKE_BUILD_TYPE=Debug \
#     -DCRYENGINE_DIR=$CRYENGINE_DIR \
#     -DCMAKE_TOOLCHAIN_FILE=$CRYENGINE_DIR/Tools/CMake/toolchain/linux/Linux_GCC.cmake \
#     -DCMAKE_C_COMPILER=gcc-14 -DCMAKE_CXX_COMPILER=g++-14
#
#   Clang (deploy to linux_x64_gcc, use with GCC engine):
#   cmake -B build/clang -G Ninja -S Code -DCMAKE_BUILD_TYPE=Debug \
#     -DCRYENGINE_DIR=$CRYENGINE_DIR \
#     -DCMAKE_TOOLCHAIN_FILE=$(pwd)/cmake/toolchain/Linux_Clang_System.cmake
#
#   Clang (deploy to linux_x64_clang, for a full Clang engine build):
#   cmake -B build/clang -G Ninja -S Code -DCMAKE_BUILD_TYPE=Debug \
#     -DCRYENGINE_DIR=$CRYENGINE_DIR \
#     -DCMAKE_TOOLCHAIN_FILE=$(pwd)/cmake/toolchain/Linux_Clang_System.cmake \
#     -DCLANG_OUTPUT_DIR_NAME=linux_x64_clang
#
# VS Code users: set "cryengineDir" in .vscode/settings.json instead.
# See CLAUDE.md > Prerequisites for full setup instructions.

CRYENGINE_DIR=/path/to/CRYENGINE
