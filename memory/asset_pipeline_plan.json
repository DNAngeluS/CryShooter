{
  "_meta": {
    "engine": "CRYENGINE 5.6",
    "topic": "asset_pipeline",
    "doc": "docs/asset_pipeline.md",
    "version": 3
  },
  "summary": {
    "goal": "Use an LLM-authored bundle graph plus deterministic Python compilers to assemble CRYENGINE-compatible environments, imported meshes, and first-person character packages.",
    "first_slice": "environment_bundle_compilation",
    "output_mode": "staged_validate_then_manual_publish",
    "tracking_mode": "json_ledger"
  },
  "entrypoints": {
    "pipeline_cli": "tools/cry_asset_pipeline.py",
    "tracker_cli": "tools/cry_asset_tracker.py",
    "stage_root": "user/asset_pipeline/jobs",
    "tracker_file": "memory/asset_pipeline_tracker.json",
    "interface_file": "memory/asset_pipeline_interface.json"
  },
  "supported_asset_kinds": [
    {
      "kind": "level",
      "status": "implemented",
      "authoring_mode": "bundle_graph",
      "bundle_kind": "environment_package",
      "capabilities": [
        "prompt_pack_generation",
        "bundle_graph_validation",
        "texture_source_nodes",
        "material_surface_nodes",
        "procedural_mesh_nodes",
        "imported_mesh_nodes",
        "terrain_archetype_nodes",
        "object_placement_set_nodes",
        "scene_level_compilation",
        "structural_validation",
        "manual_publish_to_assets"
      ]
    },
    {
      "kind": "character_package",
      "status": "implemented",
      "authoring_mode": "bundle_graph",
      "bundle_kind": "character_package",
      "capabilities": [
        "mesh_import_character_source_nodes",
        "character_fp_package_nodes",
        "first_person_runtime_template_packaging",
        "controller_definition_generation",
        "adb_generation",
        "manual_publish_to_assets"
      ]
    },
    {
      "kind": "mesh_import",
      "status": "implemented",
      "authoring_mode": "deterministic_import_recipe",
      "bundle_kind": "import_asset_bundle",
      "capabilities": [
        "source_staging",
        "obj_sidecar_copy",
        "import_recipe_generation",
        "compiler_discovery",
        "validation"
      ]
    },
    {
      "kind": "vehicle_package",
      "status": "planned",
      "capabilities": [
        "schema_placeholders_only"
      ]
    }
  ],
  "commands": [
    "create-job",
    "plan-spec",
    "author-spec",
    "edit",
    "build",
    "validate",
    "publish",
    "run",
    "convert-mesh"
  ],
  "graph_contract": {
    "top_level_fields": [
      "asset_kind",
      "bundle_kind",
      "bundle_slug",
      "summary",
      "root_scene",
      "nodes"
    ],
    "supported_node_types": [
      "scene_level",
      "terrain_archetype",
      "texture_source",
      "material_surface",
      "mesh_procedural",
      "mesh_import",
      "object_placement_set",
      "character_fp_package"
    ],
    "texture_modes": [
      "import",
      "imagegen",
      "solid_color",
      "procedural_pattern"
    ]
  },
  "defaults": {
    "lighting_preset": "%ENGINE%/EngineAssets/Shading/default.env",
    "ocean_water_level": -100,
    "heightmap_z_ratio": 0.015625,
    "sector_size": 32,
    "publish_after_success": false,
    "mesh_obj_scope": "static_geometry_only",
    "character_runtime_scope": "first_person_only",
    "generated_texture_master_format": "png",
    "bundle_authoring_mode": "bundle_graph"
  },
  "constraints": [
    "Python does not semantically interpret the prose brief into terrain, meshes, materials, textures, or character runtime structure.",
    "Terrain is template-backed and archetype-limited: flat_arena, basin, ridge_ring, valley.",
    "Procedural geometry is limited to checked-in archetypes; arbitrary freeform mesh topology generation is rejected.",
    "Imported character sources require FBX or DAE.",
    "The imagegen texture mode is integrated at the graph level, but the current compiler writes request artifacts plus deterministic fallback PNGs rather than calling an external image service directly.",
    "The pipeline stages outputs under user/ before copying validated assets into Assets/.",
    "Publish remains a separate explicit step after validation.",
    "If CRYENGINE compiler tooling is unavailable, mesh imports remain staged instead of failing silently."
  ],
  "roadmap": [
    {
      "milestone": "M1-authored-level-graphs",
      "status": "implemented",
      "scope": [
        "create_job",
        "authoring_artifacts",
        "asset_graph_validation",
        "template_backed_level_build",
        "structural_validation",
        "manual_publish"
      ]
    },
    {
      "milestone": "M2-bundle-graph-compiler",
      "status": "implemented",
      "scope": [
        "typed_node_graphs",
        "dependency_order_builds",
        "texture_source_nodes",
        "material_surface_nodes",
        "procedural_mesh_nodes",
        "mesh_import_nodes",
        "character_fp_package_nodes",
        "scene_level_compilation"
      ]
    },
    {
      "milestone": "M3-live-imagegen-and-standalone-object-bundles",
      "status": "planned",
      "scope": [
        "external_image_generation_execution",
        "standalone_object_bundle_asset_kind",
        "richer_material_channel_generation"
      ]
    },
    {
      "milestone": "M4-vehicles-and-broader-character-runtime-support",
      "status": "planned",
      "scope": [
        "vehicle_package_asset_kind",
        "non_first_person_character_templates",
        "broader_runtime_integration"
      ]
    }
  ]
}
